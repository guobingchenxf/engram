# Storage
MEMORY_DB_PATH=./data/memory.db
MEMORY_TRACE_PATH=./data/trace.jsonl

# Tenant boundary. Every store query is scoped by this value.
MEMORY_TENANT_ID=default

# Embeddings: "hash" works offline; "openai" calls an OpenAI-compatible API.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=256
EMBEDDING_MODEL=text-embedding-3-small

# LLM extraction: "heuristic" works offline; "openai" uses an OpenAI-compatible API.
LLM_PROVIDER=heuristic
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_MAX_RETRIES=2
MEMORY_LLM_RETRY_BACKOFF=0.5

# HTTP API. Authentication is required by default: set a generated key.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MEMORY_API_KEY=
MEMORY_REQUIRE_AUTH=true
# Comma-separated allowlist. Empty means no CORS headers.
MEMORY_CORS_ORIGINS=

# Retrieval
MEMORY_TOKEN_BUDGET=800
MEMORY_MAX_SCAN_CANDIDATES=20000
MEMORY_PREFILTER_CANDIDATES=300
MEMORY_RECENCY_HALF_LIFE_DAYS=30
MEMORY_DECAY_LAMBDA=0.01
MEMORY_DEDUPE_THRESHOLD=0.92
MEMORY_GRAPH_ENABLED=true
MEMORY_GRAPH_WEIGHT=0.15

# Safety / lifecycle
MEMORY_ALLOW_UNTRUSTED_SEMANTIC_WRITE=false
MEMORY_REQUIRE_CONFIRMATION_FOR_SENSITIVE=true
MEMORY_REDACT_SENSITIVE=true
MEMORY_RETRIEVAL_EXCLUDE_UNTRUSTED=false
MEMORY_ENABLE_CONFLICTS=true
MEMORY_SAFETY_ENABLED=true
MEMORY_POISON_CLASSIFIER=false
MEMORY_PROVENANCE_ENABLED=false

# Signed provenance (HMAC-SHA256). Generate a local key with:
#   engram attest-keygen
# Set the secret to sign writes accepted by this service. Set the trust store
# (JSON array) to verify agent-issued attestations from other issuers.
MEMORY_ATTESTATION_ENABLED=false
MEMORY_ATTESTATION_KEY_ID=local
MEMORY_ATTESTATION_SECRET=
MEMORY_ATTESTATION_ISSUER=engram-service
MEMORY_ATTESTATION_KEYS=
MEMORY_REQUIRE_ATTESTATION_FOR_AGENT=false
MEMORY_ATTESTATION_REQUIRE_SIGNED_PARENTS=true
