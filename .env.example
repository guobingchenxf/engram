# Storage
MEMORY_DB_PATH=./data/memory.db
MEMORY_TRACE_PATH=./data/trace.jsonl

# Embeddings: "hash" works offline; "openai" calls an OpenAI-compatible API.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=256
EMBEDDING_MODEL=text-embedding-3-small

# LLM extraction: "heuristic" works offline; "openai" uses an OpenAI-compatible API.
LLM_PROVIDER=heuristic
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_MAX_RETRIES=2
MEMORY_LLM_RETRY_BACKOFF=0.5

# Optional HTTP API key. If set, /v1/* requires X-API-Key.
MEMORY_API_KEY=

# Retrieval
MEMORY_TOKEN_BUDGET=800
MEMORY_RECENCY_HALF_LIFE_DAYS=30
MEMORY_DECAY_LAMBDA=0.01
MEMORY_DEDUPE_THRESHOLD=0.92
MEMORY_GRAPH_ENABLED=true
MEMORY_GRAPH_WEIGHT=0.15

# Safety / lifecycle
MEMORY_ALLOW_UNTRUSTED_SEMANTIC_WRITE=false
MEMORY_REQUIRE_CONFIRMATION_FOR_SENSITIVE=true
MEMORY_ENABLE_CONFLICTS=true
MEMORY_SAFETY_ENABLED=true
MEMORY_POISON_CLASSIFIER=false
MEMORY_PROVENANCE_ENABLED=false
